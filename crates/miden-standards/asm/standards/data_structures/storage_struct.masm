# Self-describing struct abstraction over a double-word array.
#
# A StorageStruct stores a header at index 0 that describes the layout of
# subsequent fields. This allows generic, reusable storage patterns for
# components like fungible faucets, NFTs, etc.
#
# Header layout (1 double-word at index 0):
#   Word0: [version, num_fields, total_size, flags]
#   Word1: [f0_size, f1_size, f2_size, f3_size]
#
# Field data starts at index 1 and is laid out consecutively.
# Field sizes are in double-words (2 Words = 64 bytes each).
#
# Supports up to 4 fields. Can be extended to 8 with additional header
# double-words in the future.

use miden::standards::data_structures::double_word_array

# PROCEDURES
# =================================================================================================

#! Reads the struct header from index 0.
#!
#! Inputs:  [slot_id_prefix, slot_id_suffix]
#! Outputs: [version, num_fields, total_size, flags, f0_size, f1_size, f2_size, f3_size]
#!
#! The output follows the top-first convention:
#!   VALUE_0 (top):    [version, num_fields, total_size, flags]
#!   VALUE_1 (bottom): [f0_size, f1_size, f2_size, f3_size]
#!
#! Invocation: exec
pub proc get_header
    # Insert index=0 below the slot ID
    push.0 movdn.2
    # => [slot_id_prefix, slot_id_suffix, 0]
    exec.double_word_array::get
    # => [VALUE_0, VALUE_1]
end

#! Gets the storage index where a field starts.
#!
#! Inputs:  [field_id, slot_id_prefix, slot_id_suffix]
#! Outputs: [start_index]
#!
#! Algorithm: start_index = 1 + sum(field_sizes[0..field_id])
#! Supports field_id 0 to 3 (up to 4 fields).
#!
#! Invocation: exec
@locals(6)
pub proc get_field_start_index
    loc_store.0
    push.0 movdn.2
    exec.double_word_array::get
    dropw
    loc_store.4
    loc_store.3
    loc_store.2
    loc_store.1
    push.1
    loc_load.0 push.0 gt
    if.true
        loc_load.1 add
        loc_load.0 push.1 gt
        if.true
            loc_load.2 add
            loc_load.0 push.2 gt
            if.true
                loc_load.3 add
                swap drop
            else
                swap drop
            end
        else
            swap drop
        end
    else
        swap drop
    end
end

#! Gets the size (in double-words) of a field.
#!
#! Inputs:  [field_id, slot_id_prefix, slot_id_suffix]
#! Outputs: [field_size]
#!
#! Supports field_id 0 to 3 (up to 4 fields).
#! Rule of 8: keep stack ≤8 before get; store result in locals, single loc_load at end.
@locals(6)
pub proc get_field_size
    # 1. Freeze context in locals; minimal stack for get (3 elements only).
    loc_store.0
    # => [slot_id_prefix, slot_id_suffix]
    push.0 movdn.2
    # => [slot_id_prefix, slot_id_suffix, 0]
    exec.double_word_array::get
    # => 8 elements (VALUE_0, VALUE_1); clean up immediately.
    dropw
    # => [f3_size, f2_size, f1_size, f0_size] (4 elements)
    loc_store.4
    loc_store.3
    loc_store.2
    loc_store.1
    # => [] — sizes in loc.1..4, field_id in loc.0
    # 2. Branch by field_id; all branches leave [] and store result in loc.5.
    loc_load.0 push.0 eq
    if.true
        loc_load.1 loc_store.5
    else
        drop
        loc_load.0 push.1 eq
        if.true
            loc_load.2 loc_store.5
        else
            drop
            loc_load.0 push.2 eq
            if.true
                loc_load.3 loc_store.5
            else
                drop
                loc_load.4 loc_store.5
            end
        end
    end
    loc_load.5
    swap drop
end

#! Reads a field's data (the first double-word of the field).
#!
#! Inputs:  [field_id, slot_id_prefix, slot_id_suffix]
#! Outputs: [VALUE_0, VALUE_1]
#!
#! For fields spanning multiple double-words, this reads only the first chunk.
#! Use get_field_chunk for accessing other chunks.
#!
#! Invocation: exec
@locals(2)
pub proc get_field
    # Save slot_id for reuse after computing start_index
    # Input: [field_id, slot_id_prefix, slot_id_suffix]
    swap loc_store.0
    # => [field_id, slot_id_suffix]
    swap loc_store.1
    # => [field_id]

    # Reconstruct args for get_field_start_index
    loc_load.1 loc_load.0
    movup.2
    # => [field_id, slot_id_prefix, slot_id_suffix]
    exec.get_field_start_index
    # => [start_index]

    # Read double-word at start_index
    loc_load.1 loc_load.0
    # => [slot_id_prefix, slot_id_suffix, start_index]
    exec.double_word_array::get
    # => [VALUE_0, VALUE_1]
end

#! Reads a specific chunk of a field.
#!
#! Inputs:  [field_id, chunk_index, slot_id_prefix, slot_id_suffix]
#! Outputs: [VALUE_0, VALUE_1]
#!
#! chunk_index is 0-based within the field. Each chunk is one double-word.
#! For a field of size N double-words, valid chunk_index values are 0..N-1.
#!
#! Invocation: exec
#! Uses loc.5..8 for inputs; get_field_start_index overwrites loc.0..4.
@locals(9)
pub proc get_field_chunk
    # Input (top-first): [field_id, chunk_index, slot_id_prefix, slot_id_suffix]
    # Save all inputs to loc.5..8 (safe from get_field_start_index which uses loc.0..4).
    loc_store.5                         # loc.5 = field_id        (was top)
    loc_store.6                         # loc.6 = chunk_index
    loc_store.7                         # loc.7 = slot_id_prefix
    loc_store.8                         # loc.8 = slot_id_suffix  (was deepest)
    # => []

    # Build [field_id, slot_id_prefix, slot_id_suffix] for get_field_start_index
    loc_load.8 loc_load.7 loc_load.5
    # => [field_id, slot_id_prefix, slot_id_suffix]
    exec.get_field_start_index
    # => [start_index]

    loc_load.6 add
    # => [start_index + chunk_index]

    # Build [slot_id_prefix, slot_id_suffix, index] for double_word_array::get
    loc_load.8 loc_load.7
    # => [slot_id_prefix, slot_id_suffix, index]
    exec.double_word_array::get
    # => [VALUE_0, VALUE_1]
end
