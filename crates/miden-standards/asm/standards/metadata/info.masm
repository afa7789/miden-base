# Metadata Info
#
# Stores account metadata (name, content URI) in fixed value slots.
# - Name: 2 value slots (2 Words = 8 felts)
# - Content URI: 6 value slots (6 Words = 24 felts)

use miden::protocol::active_account

# CONSTANTS
# =================================================================================================

const NAME_CHUNK_0_SLOT = word("miden::standards::metadata::name_chunk_0")
const NAME_CHUNK_1_SLOT = word("miden::standards::metadata::name_chunk_1")
const CONTENT_URI_0_SLOT = word("miden::standards::metadata::content_uri_0")
const CONTENT_URI_1_SLOT = word("miden::standards::metadata::content_uri_1")
const CONTENT_URI_2_SLOT = word("miden::standards::metadata::content_uri_2")
const CONTENT_URI_3_SLOT = word("miden::standards::metadata::content_uri_3")
const CONTENT_URI_4_SLOT = word("miden::standards::metadata::content_uri_4")
const CONTENT_URI_5_SLOT = word("miden::standards::metadata::content_uri_5")

# Local memory indices for get_name
const CHUNK_1_LOC = 0
const CHUNK_0_LOC = 4

# Local memory indices for get_content_uri (6 words)
const URI_0_LOC = 0
const URI_1_LOC = 4
const URI_2_LOC = 8
const URI_3_LOC = 12
const URI_4_LOC = 16
const URI_5_LOC = 20

# PROCEDURES
# =================================================================================================

#! Returns the name (2 Words).
#!
#! Inputs:  []
#! Outputs: [NAME_CHUNK_0, NAME_CHUNK_1]
#!
#! Where:
#! - NAME_CHUNK_0 is the first Word of the name
#! - NAME_CHUNK_1 is the second Word of the name
#!
#! Invocation: call
@locals(8)
pub proc get_name
    # Get chunk 1
    push.NAME_CHUNK_1_SLOT[0..2]
    exec.active_account::get_item
    # => [CHUNK_1, padding...] depth=20

    loc_storew_be.CHUNK_1_LOC dropw
    # => [padding...] depth=16

    # Get chunk 0
    push.NAME_CHUNK_0_SLOT[0..2]
    exec.active_account::get_item
    # => [CHUNK_0, padding...] depth=20

    loc_storew_be.CHUNK_0_LOC dropw
    # => [padding...] depth=16

    # Restore results: CHUNK_0 on top, CHUNK_1 below
    loc_loadw_be.CHUNK_1_LOC
    # => [CHUNK_1, remaining...] depth=16

    swapw
    # => [remaining, CHUNK_1, ...] depth=16

    loc_loadw_be.CHUNK_0_LOC
    # => [CHUNK_0, CHUNK_1, ...] depth=16
end

#! Returns the full content URI (6 Words).
#!
#! Inputs:  []
#! Outputs: [CONTENT_URI_0, CONTENT_URI_1, CONTENT_URI_2, CONTENT_URI_3, CONTENT_URI_4, CONTENT_URI_5]
#!
#! Where CONTENT_URI_0 is on top of the stack.
#!
#! Invocation: call
@locals(24)
pub proc get_content_uri
    # Store each chunk (5 down to 0)
    push.CONTENT_URI_5_SLOT[0..2]
    exec.active_account::get_item
    loc_storew_be.URI_5_LOC dropw

    push.CONTENT_URI_4_SLOT[0..2]
    exec.active_account::get_item
    loc_storew_be.URI_4_LOC dropw

    push.CONTENT_URI_3_SLOT[0..2]
    exec.active_account::get_item
    loc_storew_be.URI_3_LOC dropw

    push.CONTENT_URI_2_SLOT[0..2]
    exec.active_account::get_item
    loc_storew_be.URI_2_LOC dropw

    push.CONTENT_URI_1_SLOT[0..2]
    exec.active_account::get_item
    loc_storew_be.URI_1_LOC dropw

    push.CONTENT_URI_0_SLOT[0..2]
    exec.active_account::get_item
    loc_storew_be.URI_0_LOC dropw

    # Load highest loc last so stack is [CONTENT_URI_0, ..., CONTENT_URI_5] (CONTENT_URI_0 on top).
    loc_loadw_be.URI_5_LOC
    loc_loadw_be.URI_4_LOC
    loc_loadw_be.URI_3_LOC
    loc_loadw_be.URI_2_LOC
    loc_loadw_be.URI_1_LOC
    loc_loadw_be.URI_0_LOC
end
