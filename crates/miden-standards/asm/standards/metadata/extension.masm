# Metadata Extension
#
# A flexible key-value store for account metadata using a StorageMap slot.
# Any Word can be used as a key to store and retrieve a Word value.
#
# Usage:
#   push.MY_KEY
#   exec.miden::standards::metadata::extension::get
#   # => [VALUE]

use miden::protocol::active_account

# CONSTANTS
# =================================================================================================

# The StorageMap slot for metadata key-value pairs.
const METADATA_SLOT = word("miden::standards::metadata::extension")

# PROCEDURES
# =================================================================================================

#! Returns the value for the given key.
#!
#! Inputs:  [KEY]
#! Outputs: [VALUE]
#!
#! Where:
#! - KEY is the metadata key (Word)
#! - VALUE is the metadata value (Word), or EMPTY_WORD if not set
#!
#! Invocation: exec
pub proc get
    # => [KEY]

    push.METADATA_SLOT[0..2]
    # => [slot_id_prefix, slot_id_suffix, KEY]

    exec.active_account::get_map_item
    # => [VALUE]
end
