#! Returns content URI chunk 5.
#!
#! Inputs:  []
#! Outputs: [CONTENT_URI_5]
#!
#! Invocation: call
@locals(4)
pub proc get_content_uri_5
    push.CONTENT_URI_5_SLOT[0..2]
    exec.active_account::get_item
    loc_storew_be.VALUE_LOC dropw
    loc_loadw_be.VALUE_LOC
end
